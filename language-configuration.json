{
  "comments": {
    "blockComment": ["(*", "*)"],
    "lineComment": {
      "comment": "//",
      "noIndent": false
    }
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "<", "close": ">", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "(*", "close": " *)", "notIn": ["string"] }
  ],
  "autoCloseBefore": ":;,}] \n\t",
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["<", ">"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
        "start": "{|[|(",
        "end": "}|]|)"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "(?:\\{|\\[|\\(|:)(?:\\s|//.*|\\(\\*.*?\\*\\))*$",
    "decreaseIndentPattern": "\\}|\\]|\\)"
  }
}
